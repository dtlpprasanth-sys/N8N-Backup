    {
      "parameters": {
        "jsCode": "return $input.all().filter(item => {\n  // 1. Get the subject, convert to string, and handle nulls\n  let subject = (item.json.subject || \"\").toString().toLowerCase().trim();\n  \n  // 2. Detect subjects that specifically START with \"despatch detail\"\n  // This will match \"Despatch detail - The Rajaratna Mills...\" \n  // but will NOT match \"Re: Despatch detail...\"\n  return subject.startsWith(\"despatch detail\");\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
