    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  try {\n    let rawString = item.json.output || \"\";\n    \n    // 1. Find the boundaries of the JSON object\n    const firstBracket = rawString.indexOf('{');\n    const lastBracket = rawString.lastIndexOf('}');\n\n    if (firstBracket === -1 || lastBracket === -1) {\n      throw new Error(\"No JSON object found\");\n    }\n\n    let jsonString = rawString.substring(firstBracket, lastBracket + 1);\n\n    // 2. EXTRA SANITIZATION: Remove non-printable control characters (0x00-0x1F) \n    // and literal \\uXXXX strings that often break JSON.parse\n    jsonString = jsonString.replace(/[\\x00-\\x1F\\x7F-\\x9F]/g, \"\"); \n    \n    // 3. Parse the cleaned result\n    const parsedData = JSON.parse(jsonString);\n\n    return {\n      json: parsedData\n    };\n\n  } catch (e) {\n    return {\n      json: {\n        error: \"JSON Sanitization Failed\",\n        message: e.message,\n        original_output: item.json.output\n      }\n    };\n  }\n});"
      },
