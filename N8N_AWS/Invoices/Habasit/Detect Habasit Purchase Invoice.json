    {
      "parameters": {
        "jsCode": "return $input.all().filter(item => {\n  // 1. Extract Subject and Sender\n  // Note: We use item.json.sender because that is the key in your input data\n  const subject = (item.json.subject || \"\").toString().toLowerCase();\n  const sender = (item.json.sender || \"\").toString().toLowerCase();\n  \n  // 2. Define the target sender and subject keywords\n  const targetEmail = \"d.senthilkumar@habasit.com\";\n  const targetSubject = \"eway bills req\";\n\n  // 3. Return true only if BOTH conditions are met\n  return sender.includes(targetEmail) && subject.includes(targetSubject);\n});"
      },
