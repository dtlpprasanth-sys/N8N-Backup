    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  try {\n    // 1. Get the output string (default to empty object string if missing)\n    let output_string = item.json.output || '{}';\n\n    // 2. Clean Markdown formatting (```json ... ```)\n    if (output_string.includes(\"```json\")) {\n      output_string = output_string.split(\"```json\")[1].trim();\n      if (output_string.includes(\"```\")) {\n        output_string = output_string.split(\"```\")[0].trim();\n      }\n    }\n\n    // 3. Fix truncated JSON if it's missing the closing bracket\n    if (output_string.trim().startsWith('{') && !output_string.trim().endsWith('}')) {\n      output_string = output_string.trim() + '}';\n    }\n\n    // 4. Parse the cleaned string into a real JSON object\n    const parsed_data = JSON.parse(output_string);\n\n    return { json: parsed_data };\n\n  } catch (e) {\n    // Handle errors just like your Python script did\n    return {\n      json: {\n        error: \"Parser 1 failed\",\n        details: e.message,\n        original_output_for_debugging: item.json.output || 'Not Found'\n      }\n    };\n  }\n});"
      },
